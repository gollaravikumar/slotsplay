# SlotPlay Frontend Environment Configuration

# Production Deployment on Vercel:
# Set BACKEND_URL to your deployed Spring Boot backend URL on Render.
# Next.js will automatically proxy all /api/* and /uploads/* requests to this backend,
# ensuring seamless same-origin session cookie handling (slotplay.sid) and eliminating cross-origin CORS issues.
BACKEND_URL=https://slotplay-backend.onrender.com

# Optional: Direct client-side API URL override (if not using proxy rewrites)
# Leave empty or omit when using BACKEND_URL proxy
# NEXT_PUBLIC_API_URL=https://slotplay.onrender.com

# Local Development:
# NEXT_PUBLIC_API_URL=http://localhost:4000
